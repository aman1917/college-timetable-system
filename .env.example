# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Matches the docker-compose service below if you use that.
DATABASE_URL="postgresql://ctms:ctms_password@localhost:5432/ctms?schema=public"

# Secret used to sign session JWTs. MUST be at least 16 characters.
# Generate a strong one with:  openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string-before-deploying"

# Credentials for the administrator account created by `npm run db:seed`.
# Change the password immediately after first login in production.
SEED_ADMIN_EMAIL="admin@college.edu"
SEED_ADMIN_PASSWORD="Admin@12345"

# Default password given to seeded teacher accounts.
SEED_TEACHER_PASSWORD="Teacher@12345"

# Set to "false" to seed only the admin user and settings, with no demo data.
SEED_DEMO_DATA="true"
